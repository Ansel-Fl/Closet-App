-- Tables

CREATE TABLE categories (
    category_id    NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    category_name  VARCHAR2(20) NOT NULL UNIQUE
);

CREATE TABLE locations (
    location_id    NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    location_name  VARCHAR2(20) NOT NULL UNIQUE
);

CREATE TABLE items (
    item_id        NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    item_name      VARCHAR2(100) NOT NULL,
    category_id    NUMBER NOT NULL REFERENCES categories (category_id),
    location_id    NUMBER REFERENCES locations (location_id),
    color          VARCHAR2(20),
    season         VARCHAR2(20) CHECK (season IN ('Spring', 'Summer', 'Fall', 'Winter', 'All')),
    brand          VARCHAR2(30),
    purchase_date  DATE,
    price          NUMBER(8, 2)
);

CREATE TABLE outfits (
    outfit_id      NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    outfit_name    VARCHAR2(100) NOT NULL,
    occasion       VARCHAR2(50)
);

CREATE TABLE outfit_items (
    outfit_id      NUMBER NOT NULL REFERENCES outfits (outfit_id),
    item_id        NUMBER NOT NULL REFERENCES items (item_id),
    PRIMARY KEY (outfit_id, item_id)
);

CREATE TABLE wear_log (
    wear_id        NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    item_id        NUMBER NOT NULL REFERENCES items (item_id),
    worn_date      DATE NOT NULL,
    occasion       VARCHAR2(50)
);

